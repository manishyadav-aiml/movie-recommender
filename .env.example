# Copy to .env (never commit .env). Generate values as shown.

# Required in production:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# production | development.  production => secure cookies, HSTS, refuses to start without SECRET_KEY
APP_ENV=development

# Optional admin area (feedback inbox). Generate with:  python -m scripts.make_admin_hash
# Keep the single quotes. Leave empty to disable /admin completely.
ADMIN_PASSWORD_HASH=''

# Optional
# MOVIES_DATASET=ml-1m
# DATABASE_PATH=instance/feedback.db
# ALLOWED_ORIGINS=https://my-other-site.example   # CORS is OFF unless you list exact origins
# TRUSTED_PROXY_COUNT=1                           # set to 1 when behind nginx / a platform proxy
# APP_LAST_UPDATED=2026-11-19

# Feedback form + admin inbox need a writable disk. They are ON locally and OFF on Vercel by default.
# FEEDBACK_ENABLED=1
